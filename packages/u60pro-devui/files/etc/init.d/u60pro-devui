#!/bin/sh /etc/rc.common
# the screen UI of the U60 Pro (zwrt-devui on the ubus backend); while it runs it owns the backlight, the touch screen and the power
# key, and the hardware service (u60pro-hw, screen.manager auto) only watches

START=96
STOP=5
USE_PROCD=1

DIR=/usr/share/u60pro-devui

start_service() {
	[ -x "$DIR/zwrt-devui" ] || return 1
	# no panel (the kernel has no DRM device): nothing to draw on
	[ -e /dev/dri/card0 ] || { logger -t u60pro-devui "no /dev/dri/card0: the screen UI is not started"; return 0; }
	procd_open_instance
	procd_set_param command "$DIR/zwrt-devui"
	procd_set_param env DEVUI_FONT="$DIR/fonts/NotoSansSC-Regular-subset.otf"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}
