#!/bin/sh
# start the hardware service (in a firmware image being built, only enable it)
if [ -n "$IPKG_INSTROOT" ]; then
	"$IPKG_INSTROOT"/etc/init.d/u60pro-hw enable 2>/dev/null
	exit 0
fi
/etc/init.d/u60pro-hw enable
/etc/init.d/rpcd reload 2>/dev/null
/etc/init.d/u60pro-hw restart 2>/dev/null
exit 0
