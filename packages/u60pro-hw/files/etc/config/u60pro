# U60 Pro hardware settings (u60pro-hwd); the LuCI pages System > Screen, System > Buttons and Status > Battery edit them

config screen 'screen'
	# backlight in per cent, and the seconds without a touch or key before the screen goes dark (0: never)
	option brightness '70'
	option timeout '60'
	option dim '1'
	option wake_touch '1'
	option wake_power '1'
	# who runs the backlight and the power key: auto (this service unless the screen program is running), hwd, external
	option manager 'auto'
	option ui_process 'zwrt-devui'

config battery 'battery'
	# normal: charge to full; limit: stop at charge_stop, start again at charge_start; bypass: never charge on the charger
	option charge_mode 'normal'
	option charge_stop '80'
	option charge_start '70'
	# the driver's own protection: after 16 hours at 100 % on the charger it holds the battery near 80 %
	option long_charge_protect '1'
	# power off at this charge on battery (0: leave it to the PMIC)
	option low_shutdown '0'

# the netifd interface of the cellular data connection (what the key action data_toggle brings up and down)
config net 'net'
	option data_iface 'wwan'

# the power key (KEY_POWER, code 116): none, screen_toggle, screen_on, screen_off, wifi_toggle, data_toggle,
# powerbank_toggle, poweroff, reboot, command (with command_short / command_double / command_long)
config key 'power'
	option code '116'
	option short 'screen_toggle'
	option double 'none'
	option long 'poweroff'
	option long_ms '3000'
