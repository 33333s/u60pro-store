#!/bin/sh /etc/rc.common
# the U60 Pro hardware service: battery, charging policy, backlight, power key (ubus u60pro.hw)

START=20
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/u60pro/hwd.uc
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

# settings changed: read them again without dropping the key and battery state
reload_service() {
	ubus -t 5 call u60pro.hw reload >/dev/null 2>&1 || restart
}

service_triggers() {
	procd_add_reload_trigger u60pro
}
