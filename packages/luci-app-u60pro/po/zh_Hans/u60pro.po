msgid "%d d %d h"
msgstr "%d 天 %d 小时"

msgid "%d h %d min"
msgstr "%d 小时 %d 分"

msgid "%d min"
msgstr "%d 分钟"

msgid "%d s"
msgstr "%d 秒"

msgid "%s s"
msgstr "%s 秒"

msgid "1 hour"
msgstr "1 小时"

msgid "6 hours"
msgstr "6 小时"

msgid "24 hours"
msgstr "24 小时"

msgid "48 hours"
msgstr "48 小时"

