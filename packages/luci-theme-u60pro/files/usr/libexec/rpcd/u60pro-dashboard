#!/bin/sh
# rpcd exec plugin: what the overview page of the U60 Pro theme shows besides the hardware (see /usr/share/u60pro/dashboard.uc)
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
case "$1" in
 list) echo '{"state":{},"wifi_set":{"enabled":true}}';;
 call) case "$2" in
  state|wifi_set) exec /usr/bin/ucode /usr/share/u60pro/dashboard.uc "$2";;
  *) echo '{}';;
 esac;;
esac
